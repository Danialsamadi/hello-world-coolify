# Environment Variables Template
# Copy this file to .env for local development
# DO NOT commit .env to git

# Environment Mode
export NODE_ENV=production

# Application Port (used by the Node.js app)
export PORT=3000

# Custom Hello Message
export HELLO_MESSAGE=Hello from Coolify!

# Docker Configuration
export DOCKER_RESTART_POLICY=unless-stopped
export DOCKER_WEB_HEALTHCHECK_TEST=node -e "require('http').get('http://localhost:3000/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); })"
